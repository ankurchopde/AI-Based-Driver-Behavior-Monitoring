            FM --> CROP
            CROP --> FACENET
            FACENET --> DIST
            DIST --> TEMP_S3
        end
    end

    subgraph UDP["3. Real-Time UDP Telemetry Bridge (127.0.0.1:25000 @ 20.5 Hz)"]
